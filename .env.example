# --- Persistência -----------------------------------------------------------
# SQLite (padrão para desenvolvimento):
DATABASE_URL=sqlite:///data/copa2026.db
# SQL Server (produção) — requer pyodbc instalado:
# DATABASE_URL=mssql+pyodbc://usuario:senha@servidor:1433/copa2026?driver=ODBC+Driver+18+for+SQL+Server

# --- Scraper ----------------------------------------------------------------
SCRAPER_PACING_SECONDS=4.0
SCRAPER_MAX_RETRIES=5
SCRAPER_BACKOFF_BASE_SECONDS=8.0
SCRAPER_TIMEOUT_SECONDS=30
CACHE_ENABLED=true
CACHE_DIR=data/cache

# --- Modelo -----------------------------------------------------------------
PREDICTOR_MAX_GOALS=10
PREDICTOR_ROLLING_WINDOW=5

# --- Observabilidade --------------------------------------------------------
LOG_LEVEL=INFO
